# Copy this file to .env, then fill in the values you need. Keep .env private.

# MySQL database (import database/bhoomibandhu_dbase.sql first)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bhoomi_bandhu

# Optional weather API: https://openweathermap.org/api
OPENWEATHER_API_KEY=key_here

# Optional AI advisor API (Groq): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Local web server port (optional)
PORT=3000

# Optional external Government Schemes API.
# Paste the API endpoint URL from the provider documentation.
# The API must return a JSON array or { schemes: [...] }, { data: [...] },
# { results: [...] }, { items: [...] } or { records: [...] }.
GOV_SCHEMES_API_URL=
# Optional API key (kept on the Express server; never put this in VITE_ variables).
GOV_SCHEMES_API_KEY=
# Optional auth header customization. Defaults to Authorization: Bearer <key>.
GOV_SCHEMES_API_KEY_HEADER=Authorization
GOV_SCHEMES_API_KEY_PREFIX=Bearer
