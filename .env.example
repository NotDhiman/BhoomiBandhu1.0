# ─────────────────────────────────────────────────────────────
#  BhoomiBandhu – Environment Variables
#  Copy this file to ".env" and fill in your real keys.
#  NEVER commit ".env" to Git!
# ─────────────────────────────────────────────────────────────

# OpenWeatherMap API key
# Free tier: https://openweathermap.org/api  (sign up → API Keys tab)
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Google Gemini API key
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (optional, default 3000)
PORT=3000
=======
# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bhoomi_bandhu
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Environment Mode (development, staging, production, test)
ENVIRONMENT=development

# Authentication (JWT)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mobile OTP Configuration
OTP_HMAC_SECRET=your_32_plus_char_otp_hmac_secret_here
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_PROVIDER=mock

# External Weather API: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# External AI Advisor API (Groq): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional external Government Schemes API
GOV_SCHEMES_API_URL=
GOV_SCHEMES_API_KEY=
GOV_SCHEMES_API_KEY_HEADER=Authorization
GOV_SCHEMES_API_KEY_PREFIX=Bearer
